rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      // A moderator block must take effect on existing sessions as well as new logins.
      // Missing profiles are allowed only for the initial account creation flow.
      return request.auth != null
        && (!exists(/databases/$(database)/documents/users/$(request.auth.uid))
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('suspended', false) != true);
    }
    function adminAllowed() {
      // A role can only be provisioned manually using the Firebase console / Admin SDK.
      // No client, including the holder, may create or edit a privileged role.
      return signedIn() && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/adminRoles/$(request.auth.uid))
        && get(/databases/$(database)/documents/adminRoles/$(request.auth.uid)).data.get('active', false) == true;
    }
    function verified() { return signedIn() && request.auth.token.email_verified == true && me().data.get('suspended',false) != true; }
    function self(uid) { return signedIn() && request.auth.uid == uid; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    // V2: one account both publishes and tests. The stored role was always self-editable (a view switch),
    // so it never was a privilege; any verified member may own apps. Ownership is checked per document.
    function developer() { return verified(); }
    function profile(uid) { return get(/databases/$(database)/documents/users/$(uid)); }
    function project(pid) { return get(/databases/$(database)/documents/projects/$(pid)); }
    function assignment(id) { return get(/databases/$(database)/documents/assignments/$(id)); }
    function assignmentAfter(id) { return getAfter(/databases/$(database)/documents/assignments/$(id)); }
    function currentUtcDay(day) {
      return day is string && day.matches('\\d{4}-\\d{2}-\\d{2}')
        && timestamp.date(int(day[0:4]), int(day[5:7]), int(day[8:10])) == request.time.date();
    }
    // Supervisors hold only what the owner ticked. Nothing here lets one change staffRoles.
    function validStaffPermissions(p) {
      return p is map && p.size() >= 1
        && p.keys().hasOnly(['viewUsers','suspendUsers','archiveProjects','deleteProjects','viewReports','processDeletions','viewAudit','sendAnnouncements'])
        && p.values().hasOnly([true, false]);
    }
    function activeStaff() {
      return signedIn() && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/staffRoles/$(request.auth.uid))
        && get(/databases/$(database)/documents/staffRoles/$(request.auth.uid)).data.get('active', false) == true;
    }
    function staff(permission) {
      return activeStaff()
        && get(/databases/$(database)/documents/staffRoles/$(request.auth.uid)).data.permissions.get(permission, false) == true;
    }
    // Testers are sent to this link, so it may only ever point at Google Groups.
    function validGroupLink(d) {
      return !('groupLink' in d) || (d.groupLink is string && d.groupLink.size() <= 500
        && (d.groupLink == '' || d.groupLink.matches('https://groups\\.google\\.com/[^ ]+')));
    }
    // A project's records are removed only after the project is locked, so nothing new can arrive
    // and an interrupted deletion can be resumed. The project document itself is removed last.
    function canPurge(pid, ownerUid) {
      return adminAllowed() || staff('deleteProjects') || (developer() && ownerUid == request.auth.uid
        && project(pid).data.get('status','') == 'deleting');
    }
    match /adminRoles/{uid} {
      allow get: if signedIn() && request.auth.token.email_verified == true && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    match /staffRoles/{uid} {
      allow get: if adminAllowed() || (request.auth != null && request.auth.uid == uid);
      allow list: if adminAllowed();
      allow create: if adminAllowed()
        && uid != request.auth.uid
        && !exists(/databases/$(database)/documents/adminRoles/$(uid))
        && exists(/databases/$(database)/documents/users/$(uid))
        && request.resource.data.keys().hasOnly(['active','permissions','email','name','grantedBy','grantedAt'])
        && request.resource.data.active == true
        && validStaffPermissions(request.resource.data.permissions)
        && request.resource.data.email is string && request.resource.data.email.size() <= 200
        && request.resource.data.name is string && request.resource.data.name.size() <= 100
        && request.resource.data.grantedBy == request.auth.uid
        && request.resource.data.grantedAt == request.time;
      allow update: if adminAllowed()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['permissions','grantedBy','grantedAt'])
        && validStaffPermissions(request.resource.data.permissions)
        && request.resource.data.grantedBy == request.auth.uid
        && request.resource.data.grantedAt == request.time;
      allow delete: if adminAllowed();
    }
    // ---- Fairness (V2 phase 2): test before you publish, and one live app per developer ----
    // Accepted reports are counted from XP totals, which only grow through events the rules verified.
    // A retest is also counted as a report, so retests are not added again.
    function xpTotalsOf(uid) { return /databases/$(database)/documents/xpTotals/$(uid); }
    function acceptedReports(uid) {
      return exists(xpTotalsOf(uid)) ? get(xpTotalsOf(uid)).data.get('reports', 0) + get(xpTotalsOf(uid)).data.get('bugs', 0) : 0;
    }
    function publishSlot(uid) { return /databases/$(database)/documents/publishSlots/$(uid); }
    // A project goes live (recruiting) only together with its owner's publish slot, written in the same request.
    function canGoLive(pid) {
      return getAfter(publishSlot(request.auth.uid)).data.projectId == pid
        && getAfter(publishSlot(request.auth.uid)).data.updatedAt == request.time;
    }
    // When the current live app went live: the slot's time if the slot points at it, else when it was created.
    function liveSince(pid) {
      return exists(publishSlot(request.auth.uid)) && get(publishSlot(request.auth.uid)).data.projectId == pid
        ? get(publishSlot(request.auth.uid)).data.updatedAt
        : resource.data.get('createdAt', timestamp.value(0));
    }
    match /users/{uid} {
      allow get: if adminAllowed() || staff('viewUsers') || (request.auth != null && request.auth.uid == uid) || (developer() && resource.data.available == true);
      allow list: if adminAllowed() || staff('viewUsers') || (developer() && resource.data.available == true);
      allow create: if self(uid)
        && request.resource.data.keys().hasOnly(['name','email','role','available','createdAt'])
        && request.resource.data.role in ['tester','developer']
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.available is bool
        && request.resource.data.createdAt == request.time
        && (request.resource.data.role == 'tester' || request.resource.data.available == false);
      allow update: if self(uid) && resource.data.get('suspended',false) != true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','role','available','participationPaused'])
        // One person can both test and publish: the role is a view switch, never a privilege.
        && request.resource.data.role in ['tester','developer']
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 80
        && request.resource.data.available is bool
        && (!('participationPaused' in request.resource.data) || request.resource.data.participationPaused is bool)
        && (!request.resource.data.get('participationPaused', false) || request.resource.data.available == false);
      // Admin may quarantine users in Firestore without disabling Firebase Auth itself.
      // The suspended account immediately loses Firestore access via signedIn().
      // A supervisor can never act on the owner or on another supervisor.
      allow update: if (adminAllowed() || (staff('suspendUsers') && !exists(/databases/$(database)/documents/staffRoles/$(uid))))
        && request.auth.uid != uid
        && !exists(/databases/$(database)/documents/adminRoles/$(uid))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['suspended','available'])
        && request.resource.data.suspended is bool
        && (request.resource.data.suspended == false || request.resource.data.available == false)
        && (request.resource.data.available == resource.data.available || request.resource.data.available == false);
      allow delete: if false;
    }
    match /projects/{projectId} {
      allow get, list: if adminAllowed() || activeStaff() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if developer()
        && request.resource.data.keys().hasOnly(['name','link','ownerUid','ownerName','createdAt','testersCount','selectedTesterUids','status','tasks','groupLink'])
        && validGroupLink(request.resource.data)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerName == me().data.name
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 100
        && request.resource.data.link is string
        && request.resource.data.link.size() <= 2000
        && (request.resource.data.get('status','recruiting') == 'draft' || request.resource.data.link.matches('https://play\\.google\\.com/.*'))
        && request.resource.data.tasks is list
        && (request.resource.data.get('status','recruiting') == 'draft' ? request.resource.data.tasks.size() <= 14 : request.resource.data.tasks.size() >= 1 && request.resource.data.tasks.size() <= 14)
        && request.resource.data.tasks.join('|').size() <= 1680
        && request.resource.data.selectedTesterUids is list
        && request.resource.data.selectedTesterUids.size() == request.resource.data.testersCount
        && request.resource.data.selectedTesterUids.toSet().size() == request.resource.data.testersCount
        && request.resource.data.testersCount is int
        && (request.resource.data.get('status','recruiting') == 'draft'
          ? (request.resource.data.testersCount == 0 && request.resource.data.selectedTesterUids == [] && request.resource.data.link.size() <= 2000)
          : (request.resource.data.get('status','recruiting') == 'recruiting' && request.resource.data.testersCount > 0))
        && request.resource.data.testersCount <= 400
        && (request.resource.data.get('status','recruiting') == 'draft' || canGoLive(projectId))
        && request.resource.data.createdAt == request.time;
      allow update: if developer() && resource.data.ownerUid == request.auth.uid
        && resource.data.get('status','recruiting') == 'draft'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','link','status','testersCount','selectedTesterUids','tasks','groupLink'])
        && validGroupLink(request.resource.data)
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 70
        && request.resource.data.link is string && request.resource.data.link.size() <= 2000
        && (request.resource.data.status == 'draft' || request.resource.data.link.matches('https://play\\.google\\.com/.*'))
        && request.resource.data.tasks is list
        && (request.resource.data.status == 'draft' ? request.resource.data.tasks.size() <= 14 : request.resource.data.tasks.size() >= 1 && request.resource.data.tasks.size() <= 14)
        && request.resource.data.tasks.join('|').size() <= 1680
        && request.resource.data.selectedTesterUids is list
        && request.resource.data.selectedTesterUids.size() == request.resource.data.testersCount
        && request.resource.data.selectedTesterUids.toSet().size() == request.resource.data.testersCount
        && request.resource.data.testersCount is int
        && (request.resource.data.status == 'draft'
          ? (request.resource.data.testersCount == 0 && request.resource.data.selectedTesterUids == [])
          : (request.resource.data.status == 'recruiting' && request.resource.data.testersCount > 0 && request.resource.data.testersCount <= 400
            && canGoLive(projectId)));
      allow update: if developer() && resource.data.ownerUid == request.auth.uid
        && resource.data.get('status','recruiting') == 'recruiting'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['groupLink'])
        && validGroupLink(request.resource.data);
      // Testers may leave mid-test, so the owner can invite more. Earlier selections can only grow.
      allow update: if developer() && resource.data.ownerUid == request.auth.uid
        && resource.data.get('status','recruiting') == 'recruiting'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['selectedTesterUids','testersCount'])
        && request.resource.data.selectedTesterUids is list
        && request.resource.data.selectedTesterUids.hasAll(resource.data.get('selectedTesterUids',[]))
        && request.resource.data.selectedTesterUids.toSet().size() == request.resource.data.selectedTesterUids.size()
        && request.resource.data.testersCount is int
        && request.resource.data.testersCount == request.resource.data.selectedTesterUids.size()
        && request.resource.data.testersCount <= 400;
      // How testers join: the official Google Group with self-join requests, or individual invitations.
      allow update: if developer() && resource.data.ownerUid == request.auth.uid
        && resource.data.get('status','recruiting') == 'recruiting'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['testMode'])
        && request.resource.data.testMode in ['group','invites']
        && featureOn('officialGroup');
      // Ends recruiting once the 14-day closed test had time to run, which frees the owner's live slot.
      // Testers who already started keep reporting; only new invitations stop.
      allow update: if developer() && resource.data.ownerUid == request.auth.uid
        && resource.data.get('status','recruiting') == 'recruiting'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'completed'
        && request.time >= liveSince(projectId) + duration.value(14, 'd');
      // First step of deletion. An owner cannot use it to escape an admin archive.
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'deleting'
        && (adminAllowed() || staff('deleteProjects') || (developer() && resource.data.ownerUid == request.auth.uid
          && resource.data.get('status','recruiting') in ['draft','recruiting','completed','paused']));
      allow update: if (adminAllowed() || staff('archiveProjects'))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','statusBeforeArchive','archivedAt'])
        && (
          (resource.data.get('status','recruiting') in ['draft','recruiting','completed','paused']
            && request.resource.data.status == 'archived'
            && request.resource.data.statusBeforeArchive == resource.data.get('status','recruiting')
            && request.resource.data.archivedAt == request.time)
          ||
          (resource.data.get('status','recruiting') == 'archived'
            && resource.data.get('statusBeforeArchive','') in ['draft','recruiting','completed','paused']
            && request.resource.data.status == resource.data.statusBeforeArchive
            && !('statusBeforeArchive' in request.resource.data)
            && !('archivedAt' in request.resource.data))
        );
      allow delete: if adminAllowed() || staff('deleteProjects') || (developer() && resource.data.ownerUid == request.auth.uid
        && resource.data.get('status','') == 'deleting');
    }
    // One document per developer: which app is live, and how many accepted reports publishing has used.
    // Each new app needs 3 more accepted reports than the last one, and the previous app must no longer be live.
    // Apps that were live before this existed keep running untouched.
    match /publishSlots/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, delete: if false;
      allow create, update: if developer() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['projectId','acceptedAtPublish','updatedAt'])
        && request.resource.data.projectId is string
        && request.resource.data.projectId.size() > 0 && request.resource.data.projectId.size() <= 128
        && request.resource.data.updatedAt == request.time
        && request.resource.data.acceptedAtPublish is int
        && request.resource.data.acceptedAtPublish == (resource == null ? 0 : resource.data.get('acceptedAtPublish', 0)) + 3
        && request.resource.data.acceptedAtPublish <= acceptedReports(uid)
        && getAfter(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data.ownerUid == uid
        && getAfter(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data.get('status','recruiting') == 'recruiting'
        && (resource == null
          || !exists(/databases/$(database)/documents/projects/$(resource.data.projectId))
          || get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data.get('status','recruiting') != 'recruiting');
    }
    // Left by the short-lived application flow; readable and removable only for cleanup.
    match /applications/{applicationId} {
      allow get, list: if adminAllowed() || staff('deleteProjects') || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow delete: if canPurge(resource.data.projectId, resource.data.ownerUid);
      allow create, update: if false;
    }
    match /assignments/{assignmentId} {
      allow get, list: if adminAllowed() || staff('deleteProjects') || (signedIn()
        && (resource.data.testerUid == request.auth.uid || resource.data.ownerUid == request.auth.uid));
      allow create: if developer()
        && request.resource.data.keys().hasOnly(['projectId','testerUid','ownerUid','name','link','joinedDay','checkins','createdAt','tasks','invitationStatus','groupLink'])
        && assignmentId == request.resource.data.projectId + '_' + request.resource.data.testerUid
        && request.resource.data.ownerUid == request.auth.uid
        && project(request.resource.data.projectId).data.ownerUid == request.auth.uid
        && project(request.resource.data.projectId).data.get('status','recruiting') == 'recruiting'
        && request.resource.data.testerUid in project(request.resource.data.projectId).data.selectedTesterUids
        && request.resource.data.name == project(request.resource.data.projectId).data.name
        && request.resource.data.link == project(request.resource.data.projectId).data.link
        && request.resource.data.get('tasks',[]) == project(request.resource.data.projectId).data.get('tasks',[])
        && request.resource.data.get('groupLink','') == project(request.resource.data.projectId).data.get('groupLink','')
        && request.resource.data.testerUid != request.auth.uid
        && (profile(request.resource.data.testerUid).data.available == true
          || (exists(/databases/$(database)/documents/joinRequests/$(assignmentId))
            && get(/databases/$(database)/documents/joinRequests/$(assignmentId)).data.status == 'approved'))
        && request.resource.data.joinedDay == null
        && request.resource.data.checkins == []
        && request.resource.data.invitationStatus == 'pending'
        && request.resource.data.createdAt == request.time;
      allow update: if verified() && self(resource.data.testerUid)
        && !(project(resource.data.projectId).data.get('status','recruiting') in ['deleting','archived']) && (
        (resource.data.get('invitationStatus','legacy') == 'pending'
          && resource.data.createdAt is timestamp
          && request.time < resource.data.createdAt + duration.value(7, 'd')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['invitationStatus','respondedAt'])
          && request.resource.data.invitationStatus in ['accepted','declined']
          && request.resource.data.respondedAt == request.time
          && resource.data.joinedDay == null)
        ||
        (resource.data.joinedDay == null
          && resource.data.get('invitationStatus','legacy') in ['accepted','legacy']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['joinedDay','joinedAt'])
          && request.resource.data.joinedDay is string
          && currentUtcDay(request.resource.data.joinedDay)
          && request.resource.data.joinedAt == request.time
          && request.resource.data.checkins == [])
        ||
        (resource.data.joinedAt is timestamp
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checkins','lastCheckinAt'])
          && request.resource.data.lastCheckinAt == request.time
          && request.resource.data.checkins is list
          && request.resource.data.checkins.size() == resource.data.checkins.size() + 1
          && request.resource.data.checkins.size() <= 14
          && request.resource.data.checkins.hasAll(resource.data.checkins)
          && !(request.resource.data.checkins[request.resource.data.checkins.size()-1] in resource.data.checkins)
          && currentUtcDay(request.resource.data.checkins[request.resource.data.checkins.size()-1])
          && getAfter(/databases/$(database)/documents/reports/$(assignmentId + '_' + request.resource.data.checkins[request.resource.data.checkins.size()-1])).data.date == request.resource.data.checkins[request.resource.data.checkins.size()-1]
          && getAfter(/databases/$(database)/documents/reports/$(assignmentId + '_' + request.resource.data.checkins[request.resource.data.checkins.size()-1])).data.testerUid == resource.data.testerUid
          && request.time < resource.data.joinedAt + duration.value(15, 'd')
          && (!('lastCheckinAt' in resource.data) || request.time >= resource.data.lastCheckinAt + duration.value(14, 'h')))
        ||
        // Last time the tester opened TesterHub, shown to this app's owner only. Not proof of using the app under test.
        (resource.data.joinedDay is string
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['testerSeenAt'])
          && request.resource.data.testerSeenAt == request.time
          && (!('testerSeenAt' in resource.data) || request.time > resource.data.testerSeenAt + duration.value(1, 'h')))
      );
      allow delete: if canPurge(resource.data.projectId, resource.data.ownerUid);
    }
    match /reports/{reportId} {
      allow get, list: if adminAllowed() || staff('deleteProjects') || staff('viewReports') || (signedIn()
        && (resource.data.testerUid == request.auth.uid || resource.data.ownerUid == request.auth.uid));
      allow create: if verified()
        && !(project(request.resource.data.projectId).data.get('status','recruiting') in ['deleting','archived'])
        && request.resource.data.keys().hasOnly(['assignmentId','projectId','testerUid','ownerUid','date','tested','outcome','notes','status','createdAt','submittedAt','retestOf'])
        && (!('retestOf' in request.resource.data) || (request.resource.data.retestOf is string
          && request.resource.data.retestOf.size() <= 200
          && get(/databases/$(database)/documents/reports/$(request.resource.data.retestOf)).data.assignmentId == request.resource.data.assignmentId
          && get(/databases/$(database)/documents/reports/$(request.resource.data.retestOf)).data.testerUid == request.auth.uid
          && get(/databases/$(database)/documents/reports/$(request.resource.data.retestOf)).data.status == 'fixed'))
        && reportId == request.resource.data.assignmentId + '_' + request.resource.data.date
        && request.resource.data.testerUid == request.auth.uid
        && assignment(request.resource.data.assignmentId).data.testerUid == request.auth.uid
        && request.resource.data.ownerUid == assignment(request.resource.data.assignmentId).data.ownerUid
        && request.resource.data.projectId == assignment(request.resource.data.assignmentId).data.projectId
        && request.resource.data.date is string
        && currentUtcDay(request.resource.data.date)
        && request.resource.data.outcome in ['ok','issue','blocked']
        && request.resource.data.status == (request.resource.data.outcome in ['issue','blocked'] ? 'new' : 'ok')
        && request.resource.data.notes is string
        && request.resource.data.notes.size() >= 10
        && request.resource.data.notes.size() <= 800
        && request.resource.data.tested is string
        && request.resource.data.tested.size() <= 150
        && (assignment(request.resource.data.assignmentId).data.get('tasks',[]).size() == 0
          ? request.resource.data.tested == 'فتح التطبيق وتجربة وظيفة أساسية'
          : request.resource.data.tested in assignment(request.resource.data.assignmentId).data.tasks)
        && request.resource.data.createdAt is string
        && request.resource.data.submittedAt == request.time
        && !(request.resource.data.date in assignment(request.resource.data.assignmentId).data.checkins)
        && request.resource.data.date in assignmentAfter(request.resource.data.assignmentId).data.checkins;
      // The owner may mark a problem fixed, or record a review decision. Neither path can touch
      // what the tester wrote (tested, outcome, notes, date, timestamps), so a review is never a silent edit.
      allow update: if verified() && resource.data.ownerUid == request.auth.uid
        && !(project(resource.data.projectId).data.get('status','recruiting') in ['deleting','archived'])
        && (
          (resource.data.outcome in ['issue','blocked'] && resource.data.status == 'new'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && request.resource.data.status == 'fixed')
          ||
          (project(resource.data.projectId).data.ownerUid == request.auth.uid
            && resource.data.get('reviewStatus','') != 'accepted'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reviewStatus','reviewedAt','reviewerUid'])
            && request.resource.data.reviewStatus in ['accepted','clarify','rejected']
            && request.resource.data.reviewedAt == request.time
            && request.resource.data.reviewerUid == request.auth.uid)
        );
      allow delete: if canPurge(resource.data.projectId, resource.data.ownerUid);
    }
    // ---- Contribution XP (no Cloud Functions on Spark) ----
    // Points exist only as create-only events whose ID names what was rewarded, so nothing is paid twice:
    //   {reportId}_review  accepted daily report (10) or accepted problem report (20)
    //   {fixedReportId}_retest  accepted report that retested a fixed problem (10)
    //   {assignmentId}_cycle    14 reported days with at least 7 accepted reports (50)
    // Totals may only grow by the points of an event created in the same write, and nobody edits them otherwise.
    // Document lookups are kept few on purpose: a batch may make at most 20.
    function xpPoints(kind) { return kind == 'report' ? 10 : kind == 'bug' ? 20 : kind == 'retest' ? 10 : kind == 'cycle' ? 50 : -1; }
    function xpWeek(t) { return 'W' + string(int((t.toMillis() + 259200000) / 604800000)); }
    function xpMonth(t) { return 'M' + string(t.year() * 100 + t.month()); }
    // UTC calendar day, the daily league's period.
    function xpDay(t) { return 'D' + string(t.year() * 10000 + t.month() * 100 + t.day()); }
    function xpLedger(aid) { return /databases/$(database)/documents/xpAssignments/$(aid); }
    function validXpEvent(id, d) {
      return (d.kind in ['report','bug'] && id == d.reportId + '_review'
          && validXpReport(d, getAfter(/databases/$(database)/documents/reports/$(d.reportId)).data)
          && (d.kind == 'bug') == (getAfter(/databases/$(database)/documents/reports/$(d.reportId)).data.outcome in ['issue','blocked']))
        || (d.kind == 'retest'
          && validXpReport(d, getAfter(/databases/$(database)/documents/reports/$(d.reportId)).data)
          && id == getAfter(/databases/$(database)/documents/reports/$(d.reportId)).data.get('retestOf','') + '_retest'
          && id != '_retest')
        || (d.kind == 'cycle' && id == d.assignmentId + '_cycle' && d.reportId == ''
          && assignment(d.assignmentId).data.checkins.size() >= 14
          && get(xpLedger(d.assignmentId)).data.reports + get(xpLedger(d.assignmentId)).data.bugs >= 7);
    }
    function validXpReport(d, r) { return r.assignmentId == d.assignmentId && r.reviewStatus == 'accepted'; }
    match /contributions/{eventId} {
      allow get: if resource == null || adminAllowed() || staff('viewReports') || (signedIn()
        && (resource.data.testerUid == request.auth.uid || resource.data.ownerUid == request.auth.uid));
      allow list: if adminAllowed() || staff('viewReports') || (signedIn()
        && (resource.data.testerUid == request.auth.uid || resource.data.ownerUid == request.auth.uid));
      // Either side may record an event the rules can prove, so a lost write is recovered by the tester's next visit.
      allow create: if verified()
        && request.resource.data.keys().hasOnly(['kind','points','testerUid','ownerUid','projectId','assignmentId','reportId','awardedBy','week','month','createdAt'])
        && request.resource.data.awardedBy == request.auth.uid
        && request.auth.uid in [request.resource.data.testerUid, request.resource.data.ownerUid]
        && request.resource.data.points == xpPoints(request.resource.data.kind)
        && request.resource.data.reportId is string
        && request.resource.data.createdAt == request.time
        && request.resource.data.week == xpWeek(request.time)
        && request.resource.data.month == xpMonth(request.time)
        && assignment(request.resource.data.assignmentId).data.testerUid == request.resource.data.testerUid
        && assignment(request.resource.data.assignmentId).data.ownerUid == request.resource.data.ownerUid
        && assignment(request.resource.data.assignmentId).data.projectId == request.resource.data.projectId
        && validXpEvent(eventId, request.resource.data);
      allow update, delete: if false;
    }
    function xpEvent() { return getAfter(/databases/$(database)/documents/contributions/$(request.resource.data.lastEventId)).data; }
    function xpPrev(f) { return resource == null ? 0 : resource.data.get(f, 0); }
    // An event is new in this write when its server time is this request's time: events can never be changed.
    // `self` is this document's path: its state after the whole write must match too, so a second
    // increment of the same total inside one batch cannot slip through.
    function xpBumped(self, x) {
      return request.auth != null
        && request.resource.data.lastEventId is string
        && x.createdAt == request.time
        && x.awardedBy == request.auth.uid
        && getAfter(self).data.points == xpPrev('points') + x.points
        && request.resource.data.points == xpPrev('points') + x.points
        && request.resource.data.reports == xpPrev('reports') + (x.kind == 'report' ? 1 : 0)
        && request.resource.data.bugs == xpPrev('bugs') + (x.kind == 'bug' ? 1 : 0)
        && request.resource.data.retests == xpPrev('retests') + (x.kind == 'retest' ? 1 : 0)
        && request.resource.data.cycles == xpPrev('cycles') + (x.kind == 'cycle' ? 1 : 0)
        && request.resource.data.updatedAt == request.time;
    }
    match /xpTotals/{uid} {
      allow get, list: if verified();
      // An app counts once: its ledger holds exactly this event's points only when the event is its first.
      allow create, update: if request.resource.data.keys().hasOnly(['uid','points','reports','bugs','retests','cycles','apps','lastEventId','updatedAt'])
        && request.resource.data.uid == uid
        && xpEvent().testerUid == uid
        && xpBumped(/databases/$(database)/documents/xpTotals/$(uid), xpEvent())
        && getAfter(xpLedger(xpEvent().assignmentId)).data.lastEventId == request.resource.data.lastEventId
        && request.resource.data.apps == xpPrev('apps') + (getAfter(xpLedger(xpEvent().assignmentId)).data.points == xpEvent().points ? 1 : 0);
      allow delete: if false;
    }
    match /xpPeriods/{periodId} {
      allow get, list: if verified();
      allow create, update: if request.resource.data.keys().hasOnly(['uid','period','points','reports','bugs','retests','cycles','lastEventId','updatedAt'])
        && periodId == request.resource.data.period + '_' + request.resource.data.uid
        && request.resource.data.uid == xpEvent().testerUid
        && request.resource.data.period in [xpEvent().week, xpEvent().month, xpDay(xpEvent().createdAt)]
        && xpBumped(/databases/$(database)/documents/xpPeriods/$(periodId), xpEvent());
      allow delete: if false;
    }
    match /xpAssignments/{assignmentId} {
      allow get: if resource == null || adminAllowed() || (signedIn()
        && (resource.data.testerUid == request.auth.uid || resource.data.ownerUid == request.auth.uid));
      allow list: if adminAllowed() || (signedIn()
        && (resource.data.testerUid == request.auth.uid || resource.data.ownerUid == request.auth.uid));
      allow create, update: if request.resource.data.keys().hasOnly(['testerUid','ownerUid','projectId','points','reports','bugs','retests','cycles','lastEventId','updatedAt'])
        && xpEvent().assignmentId == assignmentId
        && request.resource.data.testerUid == xpEvent().testerUid
        && request.resource.data.ownerUid == xpEvent().ownerUid
        && request.resource.data.projectId == xpEvent().projectId
        && xpBumped(xpLedger(assignmentId), xpEvent());
      allow delete: if false;
    }
    // League display name: shown only if its owner opts in, and only their current profile name.
    match /publicProfiles/{uid} {
      allow get, list: if verified();
      allow create, update: if verified() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name','photo','hidden','consent','updatedAt'])
        && request.resource.data.name == me().data.name
        && (!('hidden' in request.resource.data) || request.resource.data.hidden is bool)
        && (!('consent' in request.resource.data) || request.resource.data.consent is bool)
        // A small square picture made in the browser, kept inline because Spark has no Storage bucket.
        && (!('photo' in request.resource.data) || (request.resource.data.photo is string
          && request.resource.data.photo.size() <= 40000
          && request.resource.data.photo.matches('data:image/(webp|jpeg);base64,[A-Za-z0-9+/=]+')))
        && request.resource.data.updatedAt == request.time;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    // ---- Admin notification center (مركز إشعارات الإدارة) ----
    // Broadcasts are readable by every verified member and filtered by role in the app; a message to one
    // user is readable only by that user. Only the owner, or staff granted sendAnnouncements, can write.
    function announcer() { return adminAllowed() || staff('sendAnnouncements'); }
    match /announcements/{noticeId} {
      allow get, list: if announcer() || (verified()
        && (resource.data.broadcast == true || resource.data.targetUid == request.auth.uid));
      allow create: if announcer()
        && request.resource.data.keys().hasOnly(['kind','audience','broadcast','targetUid','title','body','active','createdBy','createdAt'])
        && request.resource.data.kind in ['announcement','update','instruction']
        && request.resource.data.audience in ['all','developers','testers','user']
        && request.resource.data.broadcast == (request.resource.data.audience != 'user')
        && request.resource.data.targetUid is string
        && (request.resource.data.broadcast
          ? request.resource.data.targetUid == ''
          : (request.resource.data.targetUid.size() > 0 && exists(/databases/$(database)/documents/users/$(request.resource.data.targetUid))))
        && request.resource.data.title is string && request.resource.data.title.size() >= 2 && request.resource.data.title.size() <= 80
        && request.resource.data.body is string && request.resource.data.body.size() >= 2 && request.resource.data.body.size() <= 1000
        && request.resource.data.active == true
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      // Withdrawing hides a notice; nothing is deleted and the text cannot be rewritten afterwards.
      allow update: if announcer()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active'])
        && request.resource.data.active is bool;
      allow delete: if false;
    }
    // Server time of the last look at the bell, so unread counts match on every device.
    match /noticeReads/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['readAt'])
        && request.resource.data.readAt == request.time;
      allow list, delete: if false;
    }
    // Spark has no trusted server: deletion is requested here and carried out by the admin.
    match /deletionRequests/{uid} {
      allow get: if adminAllowed() || staff('processDeletions') || (request.auth != null && request.auth.uid == uid);
      allow list: if adminAllowed() || staff('processDeletions');
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email','status','createdAt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time;
      allow update: if (adminAllowed() || staff('processDeletions'))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','processedAt'])
        && request.resource.data.status == 'processed'
        && request.resource.data.processedAt == request.time;
      allow delete: if false;
    }
    // One private thread per user with the platform team. Users may write even while suspended, to appeal.
    match /supportMessages/{messageId} {
      allow get, list: if adminAllowed() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid','sender','senderUid','text','createdAt'])
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 2 && request.resource.data.text.size() <= 1000
        && request.resource.data.createdAt == request.time
        && ((request.resource.data.sender == 'user'
              && request.auth.token.email_verified == true
              && request.resource.data.uid == request.auth.uid)
          || (request.resource.data.sender == 'admin'
              && adminAllowed()
              && exists(/databases/$(database)/documents/users/$(request.resource.data.uid))));
      allow update, delete: if false;
    }
    // Only the push job (Admin SDK) reads tokens to send; no other account can, admins included.
    // The id is the token's hash, so a browser is one document, owned by whoever signed in there last.
    function validPushDevice(deviceId, d) {
      return d.uid == request.auth.uid
        && d.token is string && d.token.size() >= 20 && d.token.size() <= 4096
        && hashing.sha256(d.token).toHexString().lower() == deviceId
        && d.reminderUtcHour is int && d.reminderUtcHour >= 0 && d.reminderUtcHour <= 23
        && d.updatedAt == request.time;
    }
    match /pushDevices/{deviceId} {
      allow get: if request.auth != null && resource.data.uid == request.auth.uid;
      allow list: if false;
      allow create: if verified()
        && request.resource.data.keys().hasOnly(['uid','token','reminderUtcHour','updatedAt'])
        && validPushDevice(deviceId, request.resource.data);
      allow update: if verified()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid','reminderUtcHour','updatedAt'])
        && validPushDevice(deviceId, request.resource.data);
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
    // Admin queue and audit logs are server-only. Firebase Admin SDK bypasses client rules.
    match /adminDeleteJobs/{jobId} { allow read, write: if false; }
    // ---- Official Google Group and self-join (behind appConfig/features) ----
    function featureOn(name) {
      return exists(/databases/$(database)/documents/appConfig/features)
        && get(/databases/$(database)/documents/appConfig/features).data.get(name, false) == true;
    }
    function opening(pid) { return get(/databases/$(database)/documents/openings/$(pid)); }
    // ---- V2 exchange packs (Testers Community style), behind appConfig/features.packs ----
    // 16 members, 16 days. One open pack at a time (packMeta/current); the 16th joiner starts it and opens the next
    // in the same batch. Daily confirmations are per app; warnings are computed only by the trusted daily job.
    function packDoc(id) { return /databases/$(database)/documents/packs/$(id); }
    function packMember(id, uid) { return /databases/$(database)/documents/packs/$(id)/members/$(uid); }
    function packSeat(uid) { return /databases/$(database)/documents/packSeats/$(uid); }
    function packMetaDoc() { return /databases/$(database)/documents/packMeta/current; }
    function inPack(id) { return signedIn() && exists(packMember(id, request.auth.uid)); }
    // A member may join a new pack only when their last one is over or they are out of it.
    function seatFree(uid) {
      return !exists(packSeat(uid))
        || get(packSeat(uid)).data.packId == ''
        || get(packDoc(get(packSeat(uid)).data.packId)).data.status == 'done'
        || get(packMember(get(packSeat(uid)).data.packId, uid)).data.status == 'out';
    }
    match /packMeta/{metaId} {
      allow get: if verified();
      allow list, create, delete: if false;
      // Moved only by the batch in which the 16th member fills the open pack.
      allow update: if verified() && featureOn('packs') && metaId == 'current'
        && request.resource.data.keys().hasOnly(['openPackId','number','updatedAt'])
        && request.resource.data.number == resource.data.number + 1
        && request.resource.data.openPackId == 'p' + string(request.resource.data.number)
        && request.resource.data.updatedAt == request.time
        && getAfter(packDoc(resource.data.openPackId)).data.status == 'running'
        && get(packDoc(resource.data.openPackId)).data.status == 'open'
        && existsAfter(packDoc(request.resource.data.openPackId));
    }
    match /packs/{packId} {
      allow get: if verified();
      allow list, delete: if false;
      // The next pack, created together with the pointer move above.
      allow create: if verified() && featureOn('packs')
        && getAfter(packMetaDoc()).data.openPackId == packId
        && get(packMetaDoc()).data.openPackId != packId
        && request.resource.data.keys().hasOnly(['number','status','size','days','memberCount','createdAt'])
        && request.resource.data.number == getAfter(packMetaDoc()).data.number
        && request.resource.data.status == 'open'
        && request.resource.data.size == 16 && request.resource.data.days == 16
        && request.resource.data.memberCount == 0
        && request.resource.data.createdAt == request.time;
      // Join: one more member, written in the same batch. The 16th join starts the pack today.
      allow update: if verified() && featureOn('packs') && resource.data.status == 'open'
        && !exists(packMember(packId, request.auth.uid)) && existsAfter(packMember(packId, request.auth.uid))
        && request.resource.data.memberCount == resource.data.memberCount + 1
        && request.resource.data.memberCount <= 16
        && (request.resource.data.memberCount < 16
          ? request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount'])
          : request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount','status','startDay','startedAt'])
            && request.resource.data.status == 'running'
            && currentUtcDay(request.resource.data.startDay)
            && request.resource.data.startedAt == request.time
            && getAfter(packMetaDoc()).data.number == get(packMetaDoc()).data.number + 1);
      // Leave before the start: one member less, removed in the same batch.
      allow update: if signedIn() && resource.data.status == 'open'
        && exists(packMember(packId, request.auth.uid)) && !existsAfter(packMember(packId, request.auth.uid))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount'])
        && request.resource.data.memberCount == resource.data.memberCount - 1;
      match /members/{uid} {
        // Members see each other (apps, and the email they agreed to share); nobody else does.
        allow get: if signedIn() && (request.auth.uid == uid || inPack(packId));
        allow list: if inPack(packId);
        allow create: if self(uid) && verified() && featureOn('packs')
          && get(packDoc(packId)).data.status == 'open'
          && getAfter(packDoc(packId)).data.memberCount == get(packDoc(packId)).data.memberCount + 1
          && seatFree(uid)
          && getAfter(packSeat(uid)).data.packId == packId
          && request.resource.data.keys().hasOnly(['uid','name','email','appName','appLink','order','strikes','status','consent','joinedAt'])
          && request.resource.data.uid == uid
          && request.resource.data.name == me().data.name
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.appName is string && request.resource.data.appName.size() >= 2 && request.resource.data.appName.size() <= 70
          && request.resource.data.appLink is string && request.resource.data.appLink.size() <= 300
          && request.resource.data.appLink.matches('https://play[.]google[.]com/.+')
          && request.resource.data.order == getAfter(packDoc(packId)).data.memberCount
          && request.resource.data.strikes == 0
          && request.resource.data.status == 'active'
          && request.resource.data.consent == true
          && request.resource.data.joinedAt == request.time;
        allow delete: if self(uid) && get(packDoc(packId)).data.status == 'open'
          && getAfter(packDoc(packId)).data.memberCount == get(packDoc(packId)).data.memberCount - 1
          && getAfter(packSeat(uid)).data.packId == '';
        // Strikes and removal are written only by the daily job (Admin SDK).
        allow update: if false;
      }
      match /days/{dayId} {
        allow get, list: if inPack(packId);
        // One record per member and UTC day; the list of confirmed apps only grows, and only today.
        allow create, update: if verified() && featureOn('packs')
          && get(packDoc(packId)).data.status == 'running'
          && get(packMember(packId, request.auth.uid)).data.status == 'active'
          && dayId == request.auth.uid + '_' + request.resource.data.date
          && currentUtcDay(request.resource.data.date)
          && request.resource.data.keys().hasOnly(['uid','date','confirmed','updatedAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.confirmed is list && request.resource.data.confirmed.size() <= 15
          && !request.resource.data.confirmed.hasAny([request.auth.uid])
          && request.resource.data.updatedAt == request.time
          && (resource == null || request.resource.data.confirmed.hasAll(resource.data.confirmed));
        allow delete: if false;
      }
    }
    match /packSeats/{uid} {
      allow get: if self(uid);
      allow list, delete: if false;
      allow create, update: if self(uid) && verified()
        && request.resource.data.keys().hasOnly(['packId','updatedAt'])
        && request.resource.data.updatedAt == request.time
        && (request.resource.data.packId == ''
          ? exists(packSeat(uid)) && exists(packMember(resource.data.packId, uid)) && !existsAfter(packMember(resource.data.packId, uid))
          : existsAfter(packMember(request.resource.data.packId, uid)) && !exists(packMember(request.resource.data.packId, uid)));
    }
    match /appConfig/{configId} {
      allow get: if verified();
      allow create, update: if adminAllowed() && configId == 'features'
        && request.resource.data.keys().hasOnly(['officialGroup','packs','updatedAt'])
        && request.resource.data.get('officialGroup', false) is bool
        && request.resource.data.get('packs', false) is bool
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    // A public card for an app that takes self-join requests. Only its owner writes it, copying the app's own
    // name and opt-in link; closing is always allowed so an owner can stop requests at any time.
    match /openings/{projectId} {
      allow get, list: if verified();
      allow create, update: if developer()
        && request.resource.data.keys().hasOnly(['projectId','ownerUid','ownerName','name','link','slots','status','updatedAt'])
        && request.resource.data.projectId == projectId
        && request.resource.data.ownerUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/projects/$(projectId)).data.ownerUid == request.auth.uid
        && request.resource.data.name == getAfter(/databases/$(database)/documents/projects/$(projectId)).data.name
        && request.resource.data.link == getAfter(/databases/$(database)/documents/projects/$(projectId)).data.link
        && request.resource.data.ownerName == me().data.name
        && request.resource.data.slots is int && request.resource.data.slots >= 1 && request.resource.data.slots <= 400
        && request.resource.data.updatedAt == request.time
        && (request.resource.data.status == 'closed'
          || (request.resource.data.status == 'open' && featureOn('officialGroup')
            && getAfter(/databases/$(database)/documents/projects/$(projectId)).data.get('testMode','invites') == 'group'
            && getAfter(/databases/$(database)/documents/projects/$(projectId)).data.get('status','recruiting') == 'recruiting'));
      allow delete: if canPurge(projectId, resource.data.ownerUid);
    }
    // One request per tester and app (fixed id), never for an app they already have, never their own app.
    // Approval does not start anything: it only lets the owner send the usual invitation, and the 14 days
    // start when the tester confirms the start after opening the app's opt-in link.
    match /joinRequests/{requestId} {
      allow get, list: if adminAllowed() || staff('deleteProjects') || (signedIn()
        && (resource.data.testerUid == request.auth.uid || resource.data.ownerUid == request.auth.uid));
      allow create: if verified() && featureOn('officialGroup')
        && request.resource.data.keys().hasOnly(['projectId','ownerUid','testerUid','testerName','status','createdAt','updatedAt'])
        && requestId == request.resource.data.projectId + '_' + request.auth.uid
        && request.resource.data.testerUid == request.auth.uid
        && request.resource.data.testerName == me().data.name
        && opening(request.resource.data.projectId).data.status == 'open'
        && request.resource.data.ownerUid == opening(request.resource.data.projectId).data.ownerUid
        && request.auth.uid != request.resource.data.ownerUid
        && !exists(/databases/$(database)/documents/assignments/$(requestId))
        && request.resource.data.status == 'waiting'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
        && request.resource.data.updatedAt == request.time
        && (
          (resource.data.ownerUid == request.auth.uid && resource.data.status == 'waiting'
            && request.resource.data.status in ['approved','declined'])
          || (resource.data.testerUid == request.auth.uid && resource.data.status == 'waiting'
            && request.resource.data.status == 'cancelled')
          || (resource.data.testerUid == request.auth.uid && verified() && featureOn('officialGroup')
            && resource.data.status == 'cancelled' && request.resource.data.status == 'waiting'
            && opening(resource.data.projectId).data.status == 'open'
            && !exists(/databases/$(database)/documents/assignments/$(requestId)))
        );
      allow delete: if canPurge(resource.data.projectId, resource.data.ownerUid);
    }
    // ---- Activity monitoring (estimated) ----
    // One small document per user, written only by that user with server time; read only by the platform team.
    match /presence/{uid} {
      allow get, list: if adminAllowed() || staff('viewUsers');
      allow create, update: if verified() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['role','lastSeenAt','lastActionAt'])
        && request.resource.data.role == me().data.role
        && request.resource.data.lastSeenAt == request.time
        && (!('lastActionAt' in request.resource.data)
          || request.resource.data.lastActionAt == request.time
          || (resource != null && request.resource.data.lastActionAt == resource.data.get('lastActionAt', null)))
        && (resource == null || request.time > resource.data.lastSeenAt + duration.value(20, 's'));
      allow delete: if false;
    }
    // ---- Help center: built-in articles ship with the app; the platform owner overrides, adds or hides them ----
    function helpStep(x) {
      return x is map && x.keys().hasOnly(['title','text']) && x.keys().hasAll(['title','text'])
        && x.title is string && x.title.size() >= 1 && x.title.size() <= 80
        && x.text is string && x.text.size() <= 600;
    }
    function helpSteps(s) {
      return s is list && s.size() >= 1 && s.size() <= 12
          && (s.size() <= 0 || helpStep(s[0]))
          && (s.size() <= 1 || helpStep(s[1]))
          && (s.size() <= 2 || helpStep(s[2]))
          && (s.size() <= 3 || helpStep(s[3]))
          && (s.size() <= 4 || helpStep(s[4]))
          && (s.size() <= 5 || helpStep(s[5]))
          && (s.size() <= 6 || helpStep(s[6]))
          && (s.size() <= 7 || helpStep(s[7]))
          && (s.size() <= 8 || helpStep(s[8]))
          && (s.size() <= 9 || helpStep(s[9]))
          && (s.size() <= 10 || helpStep(s[10]))
          && (s.size() <= 11 || helpStep(s[11]));
    }
    function validHelp(d) {
      return d.keys().hasOnly(['cat','title','summary','steps','notice','imageUrl','videoUrl','order','status','updatedAt','updatedBy'])
        && d.keys().hasAll(['cat','title','summary','steps','notice','imageUrl','videoUrl','order','status','updatedAt','updatedBy'])
        && d.cat in ['start','tester','developer','faq']
        && d.title is string && d.title.size() >= 3 && d.title.size() <= 120
        && d.summary is string && d.summary.size() <= 200
        && d.notice is string && d.notice.size() <= 300
        && helpSteps(d.steps)
        // Images and videos stay external links on the free plan.
        && d.imageUrl is string && (d.imageUrl == '' || (d.imageUrl.size() <= 500 && d.imageUrl.matches('https://[^\\s<>"]+')))
        && d.videoUrl is string && (d.videoUrl == '' || (d.videoUrl.size() <= 500
          && d.videoUrl.matches('https://(www[.]|m[.])?(youtube[.]com|youtu[.]be|youtube-nocookie[.]com|vimeo[.]com|drive[.]google[.]com)/[^\\s<>"]*')))
        && d.order is int && d.order >= 0 && d.order <= 9999
        && d.status in ['published','draft','hidden']
        && d.updatedAt == request.time
        && d.updatedBy == request.auth.uid;
    }
    match /helpArticles/{slug} {
      // Anyone, even signed out, reads published articles only; drafts and hidden ones stay with the owner.
      allow get, list: if resource.data.status == 'published' || adminAllowed();
      allow create, update: if adminAllowed() && slug.matches('[a-z0-9][a-z0-9-]{1,59}') && validHelp(request.resource.data);
      allow delete: if adminAllowed();
    }
    // Which built-in articles are switched off. Slugs only: built-in text is part of the app already.
    function slugList(l) {
      return l is list && l.size() <= 16
          && (l.size() <= 0 || (l[0] is string && l[0].matches('[a-z0-9][a-z0-9-]{1,59}')))
          && (l.size() <= 1 || (l[1] is string && l[1].matches('[a-z0-9][a-z0-9-]{1,59}')))
          && (l.size() <= 2 || (l[2] is string && l[2].matches('[a-z0-9][a-z0-9-]{1,59}')))
          && (l.size() <= 3 || (l[3] is string && l[3].matches('[a-z0-9][a-z0-9-]{1,59}')))
          && (l.size() <= 4 || (l[4] is string && l[4].matches('[a-z0-9][a-z0-9-]{1,59}')))
          && (l.size() <= 5 || (l[5] is string && l[5].matches('[a-z0-9][a-z0-9-]{1,59}')))
          && (l.size() <= 6 || (l[6] is string && l[6].matches('[a-z0-9][a-z0-9-]{1,59}')))
          && (l.size() <= 7 || (l[7] is string && l[7].matches('[a-z0-9][a-z0-9-]{1,59}')))
          && (l.size() <= 8 || (l[8] is string && l[8].matches('[a-z0-9][a-z0-9-]{1,59}')))
          && (l.size() <= 9 || (l[9] is string && l[9].matches('[a-z0-9][a-z0-9-]{1,59}')))
          && (l.size() <= 10 || (l[10] is string && l[10].matches('[a-z0-9][a-z0-9-]{1,59}')))
          && (l.size() <= 11 || (l[11] is string && l[11].matches('[a-z0-9][a-z0-9-]{1,59}')))
          && (l.size() <= 12 || (l[12] is string && l[12].matches('[a-z0-9][a-z0-9-]{1,59}')))
          && (l.size() <= 13 || (l[13] is string && l[13].matches('[a-z0-9][a-z0-9-]{1,59}')))
          && (l.size() <= 14 || (l[14] is string && l[14].matches('[a-z0-9][a-z0-9-]{1,59}')))
          && (l.size() <= 15 || (l[15] is string && l[15].matches('[a-z0-9][a-z0-9-]{1,59}')));
    }
    match /helpSettings/{settingId} {
      allow get: if settingId == 'public';
      allow list: if false;
      allow create, update: if adminAllowed() && settingId == 'public'
        && request.resource.data.keys().hasOnly(['hiddenDefaults','updatedAt','updatedBy'])
        && request.resource.data.keys().hasAll(['hiddenDefaults','updatedAt','updatedBy'])
        && slugList(request.resource.data.hiddenDefaults)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }
    match /adminAuditLogs/{auditId} {
      allow get, list: if adminAllowed() || staff('viewAudit');
      allow create: if (adminAllowed()
          || (staff('suspendUsers') && request.resource.data.action in ['suspend_user','unsuspend_user'])
          || (staff('archiveProjects') && request.resource.data.action in ['archive_project','restore_project'])
          || (staff('deleteProjects') && request.resource.data.action == 'delete_project')
          || (staff('processDeletions') && request.resource.data.action == 'process_deletion')
          || (staff('sendAnnouncements') && request.resource.data.action in ['send_announcement','withdraw_announcement']))
        && request.resource.data.keys().hasOnly(['actorUid','action','targetId','targetName','createdAt'])
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.action in ['save_help_article','delete_help_article','toggle_feature','suspend_user','unsuspend_user','archive_project','restore_project','delete_project','process_deletion','grant_staff','update_staff','revoke_staff','send_announcement','withdraw_announcement']
        && request.resource.data.targetId is string
        && request.resource.data.targetId.size() <= 128
        && request.resource.data.targetName is string
        && request.resource.data.targetName.size() <= 100
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /messages/{messageId} {
      allow get, list: if adminAllowed() || staff('deleteProjects') || (signedIn()
        && (resource.data.testerUid == request.auth.uid || resource.data.ownerUid == request.auth.uid));
      allow create: if verified()
        && !(project(request.resource.data.projectId).data.get('status','recruiting') in ['deleting','archived'])
        && request.resource.data.keys().hasOnly(['assignmentId','projectId','testerUid','ownerUid','sender','senderUid','text','at','createdAt'])
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.sender in ['tester','developer']
        && ((request.resource.data.sender == 'tester' && request.resource.data.testerUid == request.auth.uid)
            || (request.resource.data.sender == 'developer' && request.resource.data.ownerUid == request.auth.uid))
        && request.resource.data.testerUid == assignment(request.resource.data.assignmentId).data.testerUid
        && request.resource.data.ownerUid == assignment(request.resource.data.assignmentId).data.ownerUid
        && request.resource.data.projectId == assignment(request.resource.data.assignmentId).data.projectId
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 2
        && request.resource.data.text.size() <= 830
        && request.resource.data.at is string
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if canPurge(resource.data.projectId, resource.data.ownerUid);
    }
  }
}
