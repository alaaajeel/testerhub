{
  "name": "testerhub-pwa",
  "private": true,
  "version": "0.3.3",
  "type": "module",
  "description": "TesterHub PWA with Firebase Web Auth, daily test reports and messaging",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "preflight": "node scripts/preflight.mjs",
    "test:rules": "firebase emulators:exec --only auth,firestore --project demo-testerhub \"node --test --test-concurrency=1 tests/emulator/*.test.mjs\"",
    "build": "node scripts/build-site.mjs",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.56.1",
    "firebase": "^12.6.0",
    "firebase-tools": "^14.26.0"
  },
  "dependencies": {
    "firebase-admin": "^13.10.0"
  }
}
